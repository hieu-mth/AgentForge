# Machine-specific runtime selection. Default is local_primary.
AGENTFORGE_MODEL_REF=local_primary

# Set these only when using cloud_primary (keep real values in .env only).
# ANTHROPIC_BASE_URL=https://approved-gateway.example/v1
# ANTHROPIC_AUTH_TOKEN=replace-with-your-token

# Optional V5 Developer response timeout (seconds, allowed 60..900).
# Default is 600 for Developer only; other AI workers keep 180.
# AGENTFORGE_DEVELOPER_TIMEOUT_SECONDS=900
