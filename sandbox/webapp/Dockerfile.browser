# Browser QA image built separately and pinned by Owner; never includes AI source.
FROM node:22-bookworm-slim
WORKDIR /opt/agentforge
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=reference package.json package-lock.json ./
RUN npm ci --no-audit --no-fund --ignore-scripts \
    && chmod -R a+rX /opt/agentforge
COPY browser_runner.mjs ./browser_runner.mjs
RUN chmod a+r ./browser_runner.mjs
USER 10001:10001
ENTRYPOINT ["/bin/sh"]
